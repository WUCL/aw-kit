{
  "name": "aw-kit",
  "version": "0.7.0",
  "type": "module",
  "description": "Allen Wu's shared front-end kit: toast/confirm notify and QuickView/slide-over panel shell (React 18+; aw-kit/ui is React 19 only and ships as TS source), Supabase-safety ESLint rules, and the aw-check-rpc-types CLI. Consumed via git tag, subpath exports only.",
  "license": "MIT",
  "exports": {
    "./notify": {
      "types": "./dist/notify/index.d.ts",
      "default": "./dist/notify/index.js"
    },
    "./notify/style.css": "./dist/notify/style.css",
    "./panel": {
      "types": "./dist/panel/index.d.ts",
      "default": "./dist/panel/index.js"
    },
    "./panel/style.css": "./dist/panel/style.css",
    "./eslint-rules": {
      "types": "./src/eslint-rules/index.d.ts",
      "default": "./src/eslint-rules/index.js"
    },
    "./design-tokens": {
      "types": "./src/design-tokens/index.d.ts",
      "default": "./src/design-tokens/index.js"
    },
    "./ui/breakpoints": "./src/ui/breakpoints.ts",
    "./ui/button": "./src/ui/button.tsx",
    "./ui/callout": "./src/ui/callout.tsx",
    "./ui/card": "./src/ui/card.tsx",
    "./ui/checkbox": "./src/ui/checkbox.tsx",
    "./ui/chip": "./src/ui/chip.tsx",
    "./ui/clamp-text": "./src/ui/clamp-text.tsx",
    "./ui/close-icon": "./src/ui/close-icon.tsx",
    "./ui/cn": "./src/ui/cn.ts",
    "./ui/empty-state": "./src/ui/empty-state.tsx",
    "./ui/field-description": "./src/ui/field-description.ts",
    "./ui/icon-button": "./src/ui/icon-button.tsx",
    "./ui/interactive": "./src/ui/interactive.ts",
    "./ui/menu-placement": "./src/ui/menu-placement.ts",
    "./ui/pressable": "./src/ui/pressable.tsx",
    "./ui/removable-chip": "./src/ui/removable-chip.tsx",
    "./ui/sanitize-number": "./src/ui/sanitize-number.ts",
    "./ui/submit-enter": "./src/ui/submit-enter.ts",
    "./ui/switch": "./src/ui/switch.tsx",
    "./ui/theme": "./src/ui/theme.ts",
    "./ui/use-trailing-dot": "./src/ui/use-trailing-dot.ts",
    "./ui/primitives/alert": "./src/ui/primitives/alert.tsx",
    "./ui/primitives/badge": "./src/ui/primitives/badge.tsx",
    "./ui/primitives/button": "./src/ui/primitives/button.tsx",
    "./ui/primitives/card": "./src/ui/primitives/card.tsx",
    "./ui/primitives/checkbox": "./src/ui/primitives/checkbox.tsx",
    "./ui/primitives/chip": "./src/ui/primitives/chip.tsx",
    "./ui/primitives/dialog": "./src/ui/primitives/dialog.tsx",
    "./ui/primitives/dropdown-menu": "./src/ui/primitives/dropdown-menu.tsx",
    "./ui/primitives/empty": "./src/ui/primitives/empty.tsx",
    "./ui/primitives/input": "./src/ui/primitives/input.tsx",
    "./ui/primitives/native-select": "./src/ui/primitives/native-select.tsx",
    "./ui/primitives/number-field": "./src/ui/primitives/number-field.tsx",
    "./ui/primitives/skeleton": "./src/ui/primitives/skeleton.tsx",
    "./ui/primitives/switch": "./src/ui/primitives/switch.tsx",
    "./ui/primitives/tabs": "./src/ui/primitives/tabs.tsx",
    "./ui/primitives/textarea": "./src/ui/primitives/textarea.tsx"
  },
  "bin": {
    "aw-check-rpc-types": "./bin/aw-check-rpc-types.mjs"
  },
  "files": [
    "dist",
    "src/eslint-rules",
    "bin",
    "src/ui",
    "src/design-tokens"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --mode panel",
    "test": "vitest run && npm run test:types && npm run lint:ui",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tests/panel/tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "lint:ui": "eslint --max-warnings 0 src/ui tests/ui scripts src/eslint-rules tests/scripts tests/eslint-rules",
    "gen:ui-names": "node scripts/gen-ui-names.mjs"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "eslint": ">=9",
    "lucide-react": "^1.72.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "cn": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/react": "^16.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "1.72.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^6.30.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.1",
    "vitest": "^4.0.0"
  }
}
